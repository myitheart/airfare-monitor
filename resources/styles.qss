/* 航价守望 — designer-aligned light aviation theme */
* { font-family: "PingFang SC", "Helvetica Neue"; font-size: 13px; color: #14274a; }
QMainWindow, QDialog { background: #f4f8fe; }
QWidget#workspaceRoot { background: #f4f8fe; }
QStackedWidget#contentPages, QWidget#pageCanvas, QWidget#pageHost { background: transparent; }
QToolTip { color: #183359; background: #ffffff; border: 1px solid #cfe0f6; border-radius: 6px; padding: 6px 9px; }

/* Left navigation */
QWidget#sidebar { background: rgba(251, 253, 255, 246); border-right: 1px solid #d9e6f6; }
QLabel#brand { color: #102e61; font-size: 21px; font-weight: 700; padding: 0; }
QLabel#tagline { color: #7189aa; font-size: 12px; padding: 1px 0 0 0; }
QLabel#sidebarNote { color: #8195b1; font-size: 11px; padding-top: 7px; }
QLabel#sidebarVersion { color: #9aacbf; font-size: 11px; padding-top: 3px; }
QPushButton#sidebarSupport { min-height: 0; border: 0; background: transparent; color: #7890ae; font-size: 11px; font-weight: 600; padding: 6px 12px 3px 12px; }
QPushButton#sidebarSupport:hover { border: 0; background: transparent; color: #1768d8; text-decoration: underline; }
QPushButton#navButton { text-align: left; border: 0; border-radius: 10px; padding: 12px 16px; margin: 1px 0; font-size: 14px; font-weight: 500; color: #526b8e; background: transparent; icon-size: 20px; }
QPushButton#navButton:hover { background: #f0f5fb; color: #2a4f7c; }
QPushButton#navButton:checked { background: #eaf2fc; color: #0f4fad; font-weight: 600; }

/* Typography */
QLabel#pageTitle { font-size: 26px; font-weight: 700; color: #102b57; }
QLabel#sectionTitle { color: #132e57; font-size: 16px; font-weight: 700; }
QLabel#muted { color: #7186a5; }
QLabel#detail { color: #8394ad; font-size: 11px; }
QLabel#detailLabel { color: #8193ac; font-size: 11px; }
QLabel#detailValue { color: #244263; font-weight: 600; }
QLabel#fieldHint { color: #788ba8; font-size: 11px; }
QLabel#metricValue { color: #102d5d; font-size: 24px; font-weight: 700; }
QLabel#metricTitle { color: #6f84a3; font-size: 13px; font-weight: 600; }
QLabel#metricDetail { color: #7187a6; font-size: 12px; }
QLabel#metricIcon { color: #246eda; font-size: 20px; padding: 2px; }
QLabel#healthValue { color: #148158; font-size: 17px; font-weight: 700; }
QFrame#dashboardStatus { background: transparent; border: 0; border-radius: 0; }
QLabel#dashboardStatusDot { color: #5b9aef; font-size: 8px; padding-top: 1px; }
QLabel#dashboardStatusText { color: #5a7394; font-size: 12px; font-weight: 500; }
QLabel#brandMotto { color: #8a9db8; font-family: "Xingkai SC", "Kaiti SC", "STKaiti", "PingFang SC"; font-size: 13px; font-style: italic; padding: 3px 12px; }

/* App status bar — quiet utility strip, not a second chrome layer */
QStatusBar#appStatusBar { background: #f6f9fd; border-top: 1px solid #d8e4f2; color: #5a7394; min-height: 28px; padding: 0 8px 0 4px; }
QStatusBar#appStatusBar::item { border: 0; }
QWidget#statusHost { background: transparent; }
QLabel#statusBarDot { color: #5b9aef; font-size: 8px; padding: 0 2px 0 10px; }
QLabel#statusBarDot[tone="idle"] { color: #5b9aef; }
QLabel#statusBarDot[tone="busy"] { color: #1b6ee8; }
QLabel#statusBarDot[tone="ok"] { color: #1f9a68; }
QLabel#statusBarDot[tone="warn"] { color: #d0891a; }
QLabel#statusBarDot[tone="error"] { color: #c84b57; }
QLabel#statusBarText { color: #4a6588; font-size: 12px; font-weight: 500; }
QLabel#statusBarMeta { color: #8a9bb2; font-size: 11px; padding-left: 2px; }

/* Buttons */
QPushButton { border: 1px solid #c8d8ed; border-radius: 10px; background: rgba(255, 255, 255, 247); padding: 9px 16px; min-height: 20px; font-weight: 600; }
QPushButton:hover { background: #edf5ff; border-color: #93b9ed; color: #125dc8; }
QPushButton:pressed { background: #dcecff; border-color: #5f97e4; }
QPushButton:focus { border-color: #3e83e5; }
QPushButton:disabled { background: #f2f5f9; border-color: #dfe6ef; color: #a1adbd; }
QPushButton#primary { background: #1b6ee8; color: white; border: 1px solid #1b6ee8; font-weight: 700; padding-left: 19px; padding-right: 19px; }
QPushButton#primary:hover { background: #0f5fd3; color: white; border-color: #0f5fd3; }
QPushButton#primary:pressed { background: #084cb5; color: white; }
QPushButton#primary:disabled { background: #aec8ed; border-color: #aec8ed; color: white; }
QPushButton#dashboardAction { min-height: 36px; padding: 0 14px; border-radius: 9px; background: rgba(255, 255, 255, 250); border: 1px solid #cbdcf2; color: #15345e; font-weight: 600; }
QPushButton#dashboardAction:hover { background: #edf5ff; border-color: #91b8ed; color: #125dc8; }
QPushButton#dashboardAction:pressed { background: #dfeeff; border-color: #75a6e7; }
QPushButton#dashboardAction:disabled { background: rgba(246, 248, 251, 238); border-color: #e0e7ef; color: #a4afbd; }
QPushButton#dashboardPrimaryAction { min-height: 36px; padding: 0 14px; border-radius: 9px; background: #1b6ee8; color: white; border: 1px solid #1b6ee8; font-weight: 700; }
QPushButton#dashboardPrimaryAction:hover { background: #0f5fd3; color: white; border-color: #0f5fd3; }
QPushButton#dashboardPrimaryAction:pressed { background: #084cb5; color: white; }
QPushButton#dashboardAction, QPushButton#dashboardPrimaryAction { icon-size: 16px; }
QPushButton#routeCandidateAction { min-height: 0; background: #eaf3ff; color: #1768d8; border: 0; border-radius: 8px; padding: 9px 14px; font-weight: 600; }
QPushButton#routeCandidateAction:hover { background: #dbeaff; color: #0d58c4; }
QPushButton#historyAction { min-height: 24px; padding: 9px 15px; border-radius: 10px; icon-size: 18px; }
QPushButton#linkButton { border: 0; background: transparent; color: #1768d8; padding: 6px 8px; }
QPushButton#linkButton:hover { background: #eaf3ff; color: #0b50ae; }
QPushButton#tableAction { padding: 5px 10px; min-width: 44px; color: #1b5fb9; }
QPushButton#routeAction, QPushButton#routeToggle { padding: 6px 13px; min-width: 50px; color: #1c5eae; }
QPushButton#swapRoute { padding: 5px 14px; border-radius: 10px; background: #f4f9ff; color: #4a6f9e; font-size: 12px; }
QPushButton#swapRoute:hover { background: #e7f1fd; border-color: #a9c9ee; color: #1768d8; }
QPushButton#routeResultAction { padding: 7px 14px; min-width: 72px; background: #176ce8; color: white; border: 1px solid #176ce8; font-weight: 700; }
QPushButton#routeResultAction:hover { background: #0e59c5; color: white; }
QPushButton#dangerAction { padding: 6px 13px; color: #cb3c4b; border-color: #efc7cd; }
QPushButton#dangerAction:hover { background: #fff0f2; color: #b72b3b; }
QPushButton#periodButton { border-radius: 8px; padding: 7px 15px; }
QPushButton#periodButton:checked { background: #1b6ce7; color: white; border-color: #1b6ce7; }
QPushButton#periodButton:checked:hover { background: #105dcf; color: white; }
QPushButton#datePickerButton { background: #edf5ff; border: 1px solid #afd0fa; color: #1764cf; font-weight: 700; padding: 9px 11px; }
QPushButton#datePickerButton:hover { background: #dcecff; border-color: #70a5ef; }

/* Cards and surfaces */
QFrame#card, QFrame#featureCard, QFrame#routeCard, QFrame#managedRouteCard, QFrame#sidePanel, QFrame#toolbarCard, QFrame#filterCard { background: rgba(255, 255, 255, 244); border: 1px solid #d9e6f5; border-radius: 12px; }
QFrame#featureCard { background: rgba(255, 255, 255, 249); }
QFrame#sidePanel { background: rgba(246, 250, 255, 242); border-color: #d5e4f7; }
QFrame#toolbarCard { background: rgba(250, 253, 255, 246); border-radius: 10px; }
QFrame#card:hover, QFrame#routeCard:hover, QFrame#managedRouteCard:hover { border-color: #9fc2ef; background: rgba(255, 255, 255, 252); }
QFrame#routeCard { border-radius: 12px; min-height: 158px; }
QFrame#managedRouteCard { border-radius: 12px; min-height: 363px; }
QLabel#routePlaneIcon { background: transparent; }
QFrame#routeCard QLabel#dashboardRouteCode { color: #102b55; font-size: 20px; font-weight: 700; }
QFrame#routeCard QLabel#dashboardRoutePrice { color: #102d5d; font-size: 24px; font-weight: 700; }
QLabel#routeMeta { color: #7187a6; font-size: 11px; }
QLabel#routeUpdated { color: #526f94; font-size: 12px; font-weight: 600; }
QFrame#routeDivider { color: #e4ebf4; background: #e4ebf4; border: 0; min-height: 1px; max-height: 1px; }
QFrame#routeSummary { background: #f1f7ff; border: 0; border-radius: 11px; }
QFrame#compareBar { background: #eaf4ff; border: 1px solid #bdd8f8; border-radius: 12px; }
QFrame#metricCard { background: rgba(255, 255, 255, 246); border: 1px solid #d9e6f5; border-radius: 12px; min-height: 112px; }
QFrame#metricCard QLabel#metricValue { font-size: 26px; }
QFrame#metricCard[accent="green"] { background: #f8fbfa; border-color: #d9e8e1; }
QFrame#metricCard[accent="blue"] { background: #f8fafc; border-color: #d8e4f2; }
QFrame#metricCard[accent="violet"] { background: #f9f8fc; border-color: #e3e0ef; }
QFrame#metricCard[accent="amber"] { background: #fbfaf7; border-color: #ebe2d2; }
QFrame#healthCard { background: rgba(247, 251, 255, 246); border: 1px solid #d5e5f7; border-radius: 13px; min-height: 66px; }
QFrame#eventListCard { background: rgba(255, 255, 255, 248); border: 1px solid #dce7f4; border-radius: 14px; }
QFrame#timelineEntry { background: transparent; border: 0; border-bottom: 1px solid #edf2f8; }
QLabel#timelineDot { color: #2478ec; font-size: 12px; padding-top: 7px; }
QLabel#timelineTime { color: #7189aa; font-size: 11px; }
QLabel#timelineMessage { color: #1c365d; font-size: 12px; }
QFrame#lowPriceTimelineEntry { background: #f0fbf6; border: 1px solid #bfead6; border-radius: 11px; margin: 3px 0 6px 0; }
QLabel#lowPriceRoute { color: #14345e; font-size: 13px; font-weight: 700; }
QLabel#lowPriceValue { color: #087f55; font-size: 17px; font-weight: 800; }
QLabel#lowPriceMeta { color: #557594; font-size: 11px; }
QPushButton#lowPriceEventAction { min-height: 0; border: 0; background: transparent; color: #087f55; font-size: 11px; padding: 2px 0; font-weight: 700; }
QPushButton#lowPriceEventAction:hover { border: 0; background: transparent; color: #056943; text-decoration: underline; }
QFrame#supportPromptCard { background: qlineargradient(x1:0,y1:0,x2:1,y2:1, stop:0 #f4fbff, stop:1 #eef5ff); border: 1px solid #cfe1f8; border-radius: 11px; margin: 2px 0 7px 0; }
QLabel#supportPromptTitle { color: #173762; font-size: 13px; font-weight: 700; }
QLabel#supportPromptText { color: #6580a3; font-size: 11px; }
QPushButton#supportPromptDismiss { min-height: 0; border: 0; background: transparent; color: #8a9bb1; font-size: 10px; padding: 2px 3px; font-weight: 400; }
QPushButton#supportPromptDismiss:hover { border: 0; background: transparent; color: #526f95; }
QPushButton#supportPromptAction { min-height: 0; border: 0; background: transparent; color: #1768d8; font-size: 11px; padding: 3px 0; font-weight: 700; }
QPushButton#supportPromptAction:hover { border: 0; background: transparent; color: #0d55b9; text-decoration: underline; }
QFrame#historyRouteSelector { background: rgba(255, 255, 255, 248); border: 1px solid #c9dcf2; border-radius: 12px; min-height: 48px; }
QComboBox#historyRouteCombo { background: transparent; border: 0; padding: 7px 32px 7px 2px; color: #18345e; font-size: 15px; font-weight: 700; }
QComboBox#historyRouteCombo:hover, QComboBox#historyRouteCombo:focus { background: transparent; border: 0; }
QFrame#historyPeriodSwitch { background: rgba(255,255,255,245); border: 1px solid #c9dcf2; border-radius: 12px; }
QFrame#historyPeriodSwitch QPushButton#periodButton { min-width: 100px; min-height: 27px; border: 0; border-radius: 10px; padding: 8px 13px; }
QLabel#periodSummary { color: #315b91; background: #f6faff; border: 1px solid #cbdff7; border-radius: 9px; padding: 8px 12px; font-weight: 600; }
QLabel#legendValid { color: #176fe4; }
QLabel#legendFailed { color: #e14c4c; }
QLabel#legendThreshold { color: #ee8a15; }
QTableWidget#historyRecords { border-radius: 11px; }
QFrame#warningCard { background: #fff8ea; border: 1px solid #edc474; border-radius: 14px; }
QFrame#infoCard { background: #eef6ff; border: 1px solid #cbdff7; border-radius: 13px; }
/* System status */
QLabel#systemVersion { color: #53729b; font-size: 13px; padding: 0 7px; }
QPushButton#systemSaveButton { min-width: 108px; min-height: 26px; padding: 9px 17px; background: #1b6ee8; color: white; border: 1px solid #1b6ee8; font-weight: 700; icon-size: 18px; }
QPushButton#systemSaveButton:hover { background: #0f5fd3; color: white; border-color: #0f5fd3; }
QFrame#systemHealthCard { border: 1px solid #d4e4f6; border-radius: 15px; min-height: 104px; }
QFrame#systemHealthCard[accent="green"] { background: #f8fbfa; border-color: #d5e8df; }
QFrame#systemHealthCard[accent="blue"] { background: #f8fafc; border-color: #d8e4f2; }
QFrame#systemHealthCard[accent="violet"] { background: #f9f8fc; border-color: #e2dfef; }
QLabel#systemHealthTitle { color: #647b9d; font-size: 13px; font-weight: 600; }
QLabel#systemHealthDetail { color: #7890af; font-size: 12px; }
QFrame#systemSettingsCard { background: rgba(255, 255, 255, 247); border: 1px solid #d7e5f5; border-radius: 17px; }
QLabel#systemSectionTitle { color: #122f59; font-size: 17px; font-weight: 800; }
QLabel#runtimeFieldLabel { color: #244263; font-size: 13px; font-weight: 600; min-width: 145px; }
QWidget#runtimePreferencesForm QComboBox { min-height: 24px; }
QCheckBox#runtimeOption { color: #203c64; font-size: 13px; padding: 7px 0; }
QPushButton#redetectButton, QPushButton#systemOutlineButton { min-height: 24px; padding: 8px 15px; color: #1a61c4; icon-size: 18px; }
QFrame#systemInfoCard { background: rgba(255, 255, 255, 241); border: 1px solid #d5e4f6; border-radius: 14px; }
QFrame#systemInfoCard:hover { border-color: #bed5f1; background: rgba(255, 255, 255, 250); }
QLabel#systemSummary { color: #34567f; font-size: 13px; font-weight: 700; }
QFrame#notificationCard { background: rgba(255, 255, 255, 247); border: 1px solid #d7e5f5; border-radius: 18px; }
QFrame#notificationCard:hover { border-color: #b8d2f2; background: rgba(255, 255, 255, 252); }
QFrame#credentialCard { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #edf6ff, stop:1 #f5f9ff); border: 1px solid #c8ddf7; border-radius: 13px; }
QFrame#notificationDivider { color: #dce7f4; background: #dce7f4; border: 0; min-height: 1px; max-height: 1px; }
QLabel#notificationSectionTitle { color: #102d59; font-size: 20px; font-weight: 800; }
QLabel#notificationSubtitle { color: #7188a9; font-size: 12px; }
QLabel#notificationFieldTitle { color: #1e3a64; font-size: 14px; font-weight: 700; }
QLabel#notificationFieldLabel { color: #1d385e; font-size: 13px; font-weight: 600; }
QLabel#notificationHelp { color: #7187a6; font-size: 12px; padding-top: 1px; }
QLabel#credentialTitle { color: #173663; font-size: 15px; font-weight: 800; }
QLabel#switchState { color: #244465; font-size: 14px; font-weight: 700; min-width: 48px; }
QLabel#eventChip { color: #1768d7; background: #e4efff; border: 1px solid #d6e6fb; border-radius: 11px; padding: 7px 14px; font-weight: 600; }
QCheckBox#reportAttachment { color: #1d385e; font-weight: 600; padding: 6px 0; }
QScrollArea#notificationScroll { background: transparent; }
QFrame#wizardPreview { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #f2f8ff, stop:1 #eaf3ff); border: 1px solid #cfe1f8; border-radius: 16px; }
QFrame#wizardSection { background: #f8fbff; border: 1px solid #d9e6f5; border-radius: 13px; }
QLabel#formSectionLabel { color: #16335e; font-size: 15px; font-weight: 700; }
QLabel#infoStrip { color: #5f789b; background: #edf5ff; border-radius: 9px; padding: 9px 12px; }

/* Pills and route typography */
QLabel#activePill { color: #087f55; background: #e7f6ef; border: 1px solid #cfe8da; border-radius: 6px; padding: 4px 9px; font-weight: 600; font-size: 12px; }
QLabel#lowPricePill { color: #087f55; background: #d9f7e9; border: 1px solid #aee7ce; border-radius: 6px; padding: 4px 9px; font-weight: 600; font-size: 12px; }
QLabel#pausedPill { color: #66788e; background: #eef2f6; border: 1px solid #dde4ec; border-radius: 6px; padding: 4px 9px; font-weight: 600; font-size: 12px; }
QLabel#sourcePill { color: #1768d7; background: #eaf2fc; border-radius: 6px; padding: 4px 9px; }
QLabel#neutralPill { color: #536b87; background: #eef2f6; border-radius: 6px; padding: 4px 9px; }
QLabel#routeCity { color: #405b7d; font-size: 13px; font-weight: 700; }
QLabel#routeCode { color: #102b55; font-size: 28px; font-weight: 800; }
QLabel#routeArrow { color: #2470d5; font-size: 20px; font-weight: 700; }
QLabel#routeLatest { color: #1264cf; font-weight: 700; }
QLabel#capacityText { color: #315379; font-weight: 700; }
QLabel#emptyState { color: #7187a5; background: rgba(255,255,255,230); border: 1px dashed #bcd0e8; border-radius: 15px; padding: 38px; }

/* Forms */
QLineEdit, QDateEdit, QTimeEdit, QComboBox, QSpinBox { border: 1px solid #c5d7ec; border-radius: 10px; padding: 9px 12px; background: rgba(255, 255, 255, 250); min-height: 24px; selection-background-color: #dcecff; }
QLineEdit:hover, QDateEdit:hover, QTimeEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #83afe9; }
QLineEdit:focus, QDateEdit:focus, QTimeEdit:focus, QComboBox:focus, QSpinBox:focus { border: 2px solid #2877e5; background: #ffffff; }
QLineEdit:disabled, QDateEdit:disabled, QTimeEdit:disabled, QComboBox:disabled, QSpinBox:disabled { background: #f1f4f8; color: #9aa9bd; }
QComboBox::drop-down, QDateEdit::drop-down { border: 0; width: 30px; }
QComboBox QAbstractItemView { border: 1px solid #c8dcf5; background: white; padding: 5px; selection-background-color: #e4f0ff; selection-color: #114fae; outline: 0; }
QComboBox#timeCombo { min-width: 108px; padding-right: 27px; }
QPushButton#comboDropButton { background: #f7faff; border: 0; border-left: 1px solid #e0e8f3; border-radius: 8px; color: #52739f; padding: 0; min-height: 0; font-size: 9px; }
QPushButton#comboDropButton:hover { background: #e8f2ff; color: #1768d8; }
QPushButton#comboDropButton:pressed { background: #dbeaff; }
QPushButton#comboDropButton:disabled { background: #f1f4f8; color: #b1bdcb; }
QFrame#stepperSpin { background: white; border: 1px solid #c5d7ec; border-radius: 10px; min-height: 42px; }
QFrame#stepperSpin:hover { border-color: #83afe9; }
QFrame#stepperSpin:disabled { background: #f1f4f8; border-color: #d8e1ec; }
QSpinBox#stepperValue { background: transparent; border: 0; padding: 7px 11px; min-height: 22px; }
QSpinBox#stepperValue:focus { background: transparent; border: 0; }
QPushButton#spinStepButton { background: transparent; border: 0; border-left: 1px solid #e0e8f3; border-radius: 3px; color: #5d7ca4; padding: 0; min-height: 0; font-size: 11px; font-weight: 700; }
QPushButton#spinStepButton:hover { background: #e9f3ff; color: #1768d8; }
QPushButton#spinStepButton:disabled { background: transparent; color: #b1bdcb; }
QCheckBox { spacing: 9px; padding: 5px 0; }
QCheckBox::indicator { width: 17px; height: 17px; }
QProgressBar#capacityBar { border: 0; border-radius: 4px; background: #e1e9f3; height: 8px; }
QProgressBar#capacityBar::chunk { border-radius: 4px; background: #2878eb; }

/* Tables */
QTableWidget { background: rgba(255,255,255,248); border: 1px solid #d9e6f5; border-radius: 13px; gridline-color: #edf2f8; alternate-background-color: #f7faff; }
QTableWidget::item { padding: 9px; border-bottom: 1px solid #edf2f8; }
QTableWidget::item:hover { background: #eff6ff; }
QTableWidget::item:selected { background: #e2efff; color: #12294d; }
QHeaderView::section { background: #f1f6fc; color: #5f7696; border: 0; border-bottom: 1px solid #dfe9f5; padding: 11px; font-weight: 700; }
QListWidget { border: 1px solid #d4e1f0; border-radius: 10px; background: white; outline: 0; }
QListWidget::item { padding: 9px; border-radius: 8px; }
QListWidget::item:hover { background: #edf5ff; }

/* Wizard and date picker */
QDialog#routeWizard, QDialog#comparisonDialog { background: #f4f8fe; }
QLabel#stepActive { background: #1c6fea; color: white; border-radius: 17px; padding: 9px 18px; font-weight: 700; }
QLabel#stepDone { background: #e2efff; color: #1b68db; border-radius: 17px; padding: 9px 18px; font-weight: 700; }
QLabel#stepPending { background: #edf2f8; color: #8798af; border-radius: 17px; padding: 9px 18px; }
QLabel#domesticTripHint { background: #fff9ec; color: #8d560a; border: 1px solid #efd9a9; border-radius: 10px; padding: 11px 13px; }
QLabel#warningText { color: #994b08; background: #fff5e5; border: 1px solid #efc67e; border-radius: 10px; padding: 11px 13px; }
QDialog#datePickerDialog { background: #ffffff; }
QDialog#supportDialog { background: #f4f8fe; }
QLabel#supportTitle { color: #102b57; font-size: 25px; font-weight: 800; }
QLabel#supportIntro { color: #5f7698; font-size: 13px; }
QFrame#supportPaymentCard { background: rgba(255, 255, 255, 248); border: 1px solid #d6e4f5; border-radius: 16px; }
QFrame#supportPaymentCard[accent="alipay"] { border-top: 3px solid #1677ff; }
QFrame#supportPaymentCard[accent="wechat"] { border-top: 3px solid #07c160; }
QLabel#supportPaymentTitle { font-size: 17px; font-weight: 800; }
QLabel#supportQrImage { background: #ffffff; border: 1px solid #e0e8f1; border-radius: 12px; padding: 6px; color: #8a99ad; }
QLabel#supportPaymentHint { color: #8193aa; font-size: 11px; }
QLabel#supportNote { color: #7187a5; font-size: 11px; padding: 3px; }
QPushButton#supportCloseButton { min-width: 86px; min-height: 24px; }
QCalendarWidget#datePickerCalendar { background: white; border: 1px solid #d7e4f2; border-radius: 11px; }
QCalendarWidget#datePickerCalendar QToolButton { min-height: 36px; border: 0; background: #f1f7ff; color: #152d55; font-weight: 700; padding: 5px; }
QCalendarWidget#datePickerCalendar QToolButton:hover { background: #dfedff; }
QCalendarWidget#datePickerCalendar QAbstractItemView { font-size: 14px; background: white; color: #203759; selection-background-color: #1b6ce7; selection-color: white; }

/* Scroll areas */
QScrollArea, QScrollArea > QWidget, QScrollArea > QWidget > QWidget { border: 0; background: transparent; }
QScrollArea#routeScroll { background: transparent; border: 0; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 3px; }
QScrollBar::handle:vertical { background: #c3d3e8; border-radius: 4px; min-height: 34px; }
QScrollBar::handle:vertical:hover { background: #93b3df; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

/* Existing onboarding remains visually compatible with the refreshed shell. */
QFrame#onboardingBrand { background: #0d315f; border: 0; }
QWidget#onboardingContent { background: #f7faff; }
QLabel#onboardingTitle { color: #0d2b55; font-size: 30px; font-weight: 700; }
QLabel#onboardingBrandTitle { color: white; font-size: 29px; font-weight: 700; }
QLabel#onboardingBrandText { color: #d9e9ff; font-size: 15px; }

/* ── 托盘菜单（macOS 防崩路径下的 QMenu.popup）── 近似原生 NSMenu 观感：
   半透明面板、大圆角、内缩的圆角高亮条、细分隔线。 */
QMenu#trayMenu {
    background: rgba(248, 249, 251, 242);
    border: 1px solid rgba(120, 130, 150, 70);
    border-radius: 12px;
    padding: 5px 0;
    font-size: 14px;
    color: #1d1d1f;
}
QMenu#trayMenu::item {
    padding: 5px 24px 5px 16px;
    margin: 1px 7px;
    border-radius: 7px;
    color: #1d1d1f;
}
QMenu#trayMenu::item:selected {
    background: #2563eb;
    color: #ffffff;
}
QMenu#trayMenu::item:disabled {
    color: #98989f;
}
QMenu#trayMenu::separator {
    height: 1px;
    background: rgba(120, 130, 150, 55);
    margin: 5px 12px;
}
/* 可勾选项的文字本身会切换（暂停/继续），隐藏默认方块指示器更接近原生 */
QMenu#trayMenu::indicator {
    width: 0;
    height: 0;
}
